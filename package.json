{
  "name": "@vault-plugin-factory/core",
  "version": "0.1.0",
  "description": "Template-driven HashiCorp Vault custom plugin factory",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-codebuild": "^3.1083.0",
    "@aws-sdk/client-s3": "^3.1083.0",
    "@aws-sdk/client-ssm": "^3.1084.0",
    "jszip": "^3.10.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.7",
    "typescript": "^5.8.3",
    "vitest": "^2.1.9"
  }
}
